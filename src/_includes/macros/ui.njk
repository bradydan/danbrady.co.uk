{# Text-only call-to-action link with a trailing chevron. #}
{% macro linkButton(href, label, extraClass = "") %}
<a class="button {{ extraClass }}" href="{{ href }}">
  <span class="button-label">{{ label }}</span>
  <svg class="button-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="9 18 15 12 9 6" /></svg>
</a>
{% endmacro %}
