---
layout: layouts/base.njk
---
<section class="page">
  <h1 class="page-title">{{ title }}</h1>
  <p class="project-meta">{{ location }}, {{ year }} — {{ photos | length }} frames</p>
  <p class="project-description">{{ description }}</p>

  <div class="gallery-grid" data-lightbox-gallery>
    {% for photo in photos %}
    {# A real link, so each frame is shareable and works without JS; the
       lightbox intercepts the click when JS is available. #}
    <a class="gallery-item" href="/projects/{{ page.fileSlug }}/{{ photo.src | photoSlug }}/" data-lightbox-open data-index="{{ loop.index0 }}">
      {% image photo.src, photo.alt, photo.caption, "full" %}
    </a>
    {% endfor %}
  </div>

  <div class="lightbox" data-lightbox hidden role="dialog" aria-modal="true" aria-label="Photograph viewer">
    <button type="button" class="lightbox-control lightbox-control--close" data-lightbox-close aria-label="Close viewer">×</button>
    <button type="button" class="lightbox-control lightbox-control--prev" data-lightbox-prev aria-label="Previous photo">‹</button>
    <div class="lightbox-content" data-lightbox-content></div>
    <p class="lightbox-caption" data-lightbox-caption></p>
    <a class="lightbox-permalink" data-lightbox-permalink href="#">Open this frame's page</a>
    <button type="button" class="lightbox-control lightbox-control--next" data-lightbox-next aria-label="Next photo">›</button>
  </div>
</section>

<script type="application/json" data-lightbox-data>
{{ photos | dump | safe }}
</script>
