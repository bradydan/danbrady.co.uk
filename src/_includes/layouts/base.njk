<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{# Applied before first paint so a saved light theme does not flash dark. #}
<script>
(function(){try{var t=localStorage.getItem("theme");if(t)document.documentElement.setAttribute("data-theme",t);}catch(e){}})();
</script>
{% include "partials/seo.njk" %}
{# Figtree is self-hosted (see the Fonts section of style.css). Preloaded
   because the browser would otherwise only discover it after parsing the
   stylesheet, delaying the swap from the fallback face. #}
<link rel="preload" href="/fonts/figtree-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/style.css">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
{% include "partials/nav.njk" %}
<main id="main">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
<script>
// Decode anti-harvest email links. Kept inline so it runs without an extra
// request; the offset must match encodeEmail() in _data/site.js.
(function () {
  document.querySelectorAll("a.eml").forEach(function (a) {
    var e = a.getAttribute("data-e");
    if (!e) return;
    var addr = e.split(",").map(function (n) {
      return String.fromCharCode(parseInt(n, 10) - 13);
    }).join("");
    a.setAttribute("href", "mailto:" + addr);
    a.textContent = addr;
  });
})();
</script>
<script src="/js/site.js" defer></script>
<script src="/js/lightbox.js" defer></script>
</body>
</html>
