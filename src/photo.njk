---
layout: layouts/base.njk
pagination:
  data: collections.photos
  size: 1
  alias: photo
permalink: "/projects/{{ photo.projectSlug }}/{{ photo.slug }}/"
eleventyComputed:
  # Uncaptioned frames fall back to a project-and-position title rather than
  # the alt text, which is a description of the image, not a name for it.
  title: "{{ photo.caption if photo.caption else photo.projectTitle + ' — frame ' + photo.position }}"
  description: "{{ photo.alt }} — from {{ photo.projectTitle }}, {{ photo.location }}, {{ photo.year }}, by Dan Brady."
  isPhoto: true
---
<article class="photo">

  <nav class="photo-breadcrumb">
    <a class="link-plain" href="/projects/">Projects</a>
    <span aria-hidden="true"> / </span>
    <a class="link-plain" href="{{ photo.projectUrl }}">{{ photo.projectTitle }}</a>
    <span aria-hidden="true"> / </span>
    <span>Frame {{ photo.position }} of {{ photo.total }}</span>
  </nav>

  <div class="photo-frame">
    {% image photo.src, photo.alt, null, "full", true %}
  </div>

  <div class="photo-header">
    <div>
      <h1 class="section-title">{% if photo.caption %}{{ photo.caption }}{% else %}{{ photo.projectTitle }} — frame {{ photo.position }}{% endif %}</h1>
      <p class="project-meta">{{ photo.location }}, {{ photo.year }}</p>
    </div>
    <a class="button" href="{{ photo.projectUrl }}">All {{ photo.total }} frames</a>
  </div>

  <p class="photo-context">
    From <a class="link-accent" href="{{ photo.projectUrl }}">{{ photo.projectTitle }}</a>, a documentary project by {{ site.author }}. {{ photo.projectDescription }}
  </p>

  <nav class="photo-pager">
    {% if photo.prev %}
    <a rel="prev" href="/projects/{{ photo.projectSlug }}/{{ photo.prev.slug }}/">‹ {{ photo.prev.caption or "Previous frame" }}</a>
    {% endif %}
    {% if photo.next %}
    <a rel="next" href="/projects/{{ photo.projectSlug }}/{{ photo.next.slug }}/">{{ photo.next.caption or "Next frame" }} ›</a>
    {% endif %}
  </nav>

</article>
