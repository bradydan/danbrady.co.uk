---
layout: layouts/base.njk
---
{% from "macros/ui.njk" import linkButton %}
<div class="home">
  <div class="home-inner">
    {% for project in collections.projects %}
      {% if loop.first %}
      <div class="home-hero">
        <div>
          <p class="home-hero-statement">I used to make photographs</p>
          <p class="home-hero-subtitle">Occasionally, I still do.</p>
          {{ linkButton("/projects/", "All projects", "home-hero-cta") }}
        </div>
        <a class="card" href="/projects/{{ project.fileSlug }}/">
          <div class="home-hero-image">
            {% image project.data.cover, "Cover photo for " + project.data.title, null, "hero", true %}
          </div>
          <div class="meta-row">
            <span>{{ project.data.title }} — {{ project.data.location }}, {{ project.data.year }}</span>
            <span>{{ project.data.photos | length }} frames</span>
          </div>
        </a>
      </div>
      {% endif %}
    {% endfor %}

    <div class="home-insets">
      {% for project in collections.projects %}
        {% if not loop.first %}
        <a class="card home-inset" href="/projects/{{ project.fileSlug }}/">
          {% image project.data.cover, "Cover photo for " + project.data.title, null, loop.index0 | insetPreset %}
          <div class="meta-row">
            <span>{{ project.data.title }} — {{ project.data.location }}, {{ project.data.year }}</span>
            <span>{{ project.data.photos | length }} frames</span>
          </div>
        </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>
